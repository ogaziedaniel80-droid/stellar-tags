# ---------------------------------------------------------------------------
# Stellar Payment Platform — environment variables
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Optional pool tuning: append &connection_limit=10&pool_timeout=5
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stellar_tags?schema=public"

# Port the API server listens on (defaults to 5000).
# PORT=5000

# Horizon listener network: "testnet" (default) or "public".
# HORIZON_NETWORK=testnet

# Redis connection string for rate limiting and the BullMQ webhook worker.
# The webhook worker defaults to redis://127.0.0.1:6379 if not provided.
# REDIS_URL="redis://localhost:6379"
# PAYMENT_STREAM=payments
# FRAUD_CONSUMER_GROUP=fraud-detectors
# FRAUD_HIGH_RISK_THRESHOLD=0.8
# OTEL_SERVICE_NAME=stellar-tags-api
# OTEL_EXPORTER_ZIPKIN_ENDPOINT="http://localhost:9411/api/v2/spans"
#
# High-availability Redis Cluster seeds (comma-separated). When set, the BullMQ
# webhook queue and worker use an ioredis Cluster client instead of REDIS_URL,
# with sharding and automatic failover. Accepts host:port, redis://host:port and
# rediss://host:port (TLS) entries; malformed entries are ignored and an
# unusable list falls back to REDIS_URL.
#
# Locally: docker compose --profile cluster up, then
# REDIS_CLUSTER_NODES="redis-cluster-1:6379,redis-cluster-2:6379,redis-cluster-3:6379"
# REDIS_CLUSTER_NODES=""

# --- Logging (rotating files) -------------------------------------------------
# Directory the rotating log files are written to.
# Defaults to `stellar-payment-platform/logs`.
# LOG_DIR="./logs"

# Minimum level to record: error | warn | info | http | verbose | debug | silly.
# Defaults to "info" in production and "debug" everywhere else.
# LOG_LEVEL=info

# Rotate the active log file once it grows past this size.
# LOG_MAX_SIZE=20m

# How much history to keep. Accepts a count ("30") or an age ("14d").
# LOG_MAX_FILES=14d

# Port for Prometheus metrics (if running on separate port)
# Leave unset to serve /metrics on the main app port
# METRICS_PORT=9090
# --- Error reporting (Sentry) --------------------------------------------------
# When set, unhandled errors (including 5xx Express errors, uncaught exceptions
# and unhandled promise rejections) are reported to this Sentry project.
# Left unset, Sentry is never initialized (e.g. local dev, tests).
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# --- Startup migration check --------------------------------------------------
# Behaviour when `prisma migrate status` finds the database out of sync:
#   "strict" -> log an error and exit (non-zero) before the server binds a port
#   "warn"   -> log a warning and keep booting (default)
#   "off"    -> skip the startup check entirely
# MIGRATION_POLICY=warn

# --- Admin API Key -------------------------------------------------------------
# Key used to authenticate with protected admin endpoints (e.g., blocking addresses)
ADMIN_API_KEY="your-secure-admin-api-key-here"

# --- CORS ------------------------------------------------------------------
# Extra origins allowed to call the API, beyond the built-in localhost/vercel
# defaults. Accepts a single origin or a comma-separated list.
# CORS_ALLOWED_ORIGINS="https://example.com,https://staging.example.com"
# VITE_API_BASE="https://api.yourdomain.com"

# --- JWT (RS256) --------------------------------------------------------------
# RSA key pair for signing and verifying JWTs.
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the file contents below, replacing literal newlines with \n,
# or keep multi-line PEM values inside double quotes.
#
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
#
# Token lifetime (default: 1h). Accepts ms/zeit-ms format or seconds.
# JWT_EXPIRY="1h"


# --- Internal service-to-service mTLS (#736) ---------------------------------
# When enabled the API listens on HTTPS and requires a client certificate from
# the internal CA before any request is routed. Plain HTTP stays the default so
# local development and CI are unaffected. See docs/mtls.md.
# MTLS_ENABLED=true

# Trust anchor: the root CA plus every live issuing CA. Rotate with
#   npm run pki:rotate
# MTLS_CA_FILE="./certs/ca-bundle.crt"

# This service's own identity. Used both to serve the API and to authenticate
# outbound calls to other internal services.
# MTLS_CERT_FILE="./certs/services/api.crt"
# MTLS_KEY_FILE="./certs/services/api.key"

# Optional: a distinct certificate for outbound calls. Defaults to the server
# certificate above when unset.
# MTLS_CLIENT_CERT_FILE="./certs/services/api.crt"
# MTLS_CLIENT_KEY_FILE="./certs/services/api.key"

# How peer certificates are enforced. `required` rejects any client that
# presents nothing; `verify-if-given` lets anonymous callers through to the
# middleware; `none` disables the check.
# MTLS_CLIENT_AUTH=required

# Minimum protocol accepted. TLSv1.2 or TLSv1.3.
# MTLS_MIN_VERSION=TLSv1.2

# Optional cipher list, in OpenSSL order. Node's defaults apply when unset.
# MTLS_CIPHERS="ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256"

# Identities allowed to call this service (comma-separated). Matched against
# the certificate's URI SAN first, then its DNS SAN, then its CN. The container
# healthcheck identity must be listed too, or the probe is rejected by the very
# policy it verifies.
# MTLS_REQUIRED_SANS="spiffe://stellar-tags/internal/edge,spiffe://stellar-tags/internal/healthcheck"

# Hosts treated as internal. Requests to these must be HTTPS and carry a client
# certificate; everything else keeps using plain fetch and is never given one.
# MTLS_INTERNAL_DOMAINS="backend,edge,fraud-worker,localhost,127.0.0.1"

# Pick up rotated certificates without a restart. The running context is kept
# until the new material validates, so a bad file cannot drop connections.
# MTLS_HOT_RELOAD=true
# MTLS_RELOAD_INTERVAL_MS=30000

# Max sockets on the pooled outbound mTLS connection (default 64).
# MTLS_MAX_SOCKETS=64

# Inline PEM alternatives to the *_FILE variables, for platforms where the
# material is injected as a secret rather than mounted as a file.
# MTLS_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# MTLS_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# MTLS_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
